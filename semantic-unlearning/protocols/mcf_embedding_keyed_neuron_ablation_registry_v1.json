    {
      "name": "no_compositional_negative_loss",
      "change_only": {"detector_negative_weight": 0.0, "detector_cross_weight": 0.0},
      "question": "Do shared-subword, fragment, and cross-record negatives create contextual locality?"
    },
    {
      "name": "no_writer_off_constraint",
      "change_only": {"detector_writer_off_weight": 0.0, "writer_off_nll_weight": 0.0},
      "question": "Is explicit key dependence required to prevent a stand-alone MLP edit?"
    }
  ],
  "capacity_ablations": {
